//@version=6
strategy("Raul Lateralidade v3.4", overlay=true, margin_long=100, margin_short=100)

// ==========================================
// --- INPUTS ---
// ==========================================
lenCurta  = input.int(9, "SMA Curta", tooltip="Média Móvel Simples de curto prazo.")
lenLonga  = input.int(21, "SMA Longa", tooltip="Média Móvel Simples de longo prazo.")
lookback  = input.int(7, "Lookback Lateralidade", minval=1, tooltip="Período de observação para detectar a lateralidade (sugestão: 7 a 14).")

// --- CONTROLES DE SENSIBILIDADE (VALORES SUGERIDOS) ---
thrFlat    = input.float(1.1, "Sensibilidade Inclinação", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta média horizontal.")
thrSqueeze = input.float(0.5, "Sensibilidade Squeeze", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta médias próximas.")
thrBarcode = input.int(6, "Sensibilidade 'Código de Barras'", minval=2, maxval=14, tooltip="Trocas de cor para indicar indecisão.")

// --- PERSISTÊNCIA E CARÊNCIA (FILTRO ANTI-RUÍDO) ---
holdConsolid = input.int(3, "Persistência Lateral", minval=0, maxval=10, tooltip="Número de barras para manter o filtro amarelo ativo após detecção inicial. Evita o 'abre e fecha' rápido de ordens em áreas de whipsaw.")
minBarsBetweenTrades = input.int(1, "Barra de Carência", minval=0, maxval=10, tooltip="Mínimo de barras de espera após sair de uma operação antes de poder re-entrar.")

// ==========================================
// --- CÁLCULOS ---
// ==========================================
smaCurta = ta.sma(close, lenCurta)
smaLonga = ta.sma(close, lenLonga)
atr      = ta.atr(lookback)

// Plot das Médias
plot(smaCurta, color=color.orange, linewidth=2, title="SMA Curta")
plot(smaLonga, color=color.blue, linewidth=2, title="SMA Longa")

// --- DETECÇÃO DE LATERALIDADE ---
// 1. Horizontalidade (Slope da SMA Curta)
smaSlope = math.abs(smaCurta - smaCurta[5]) / atr
isFlatSMA = smaSlope < (thrFlat / 4)

// 2. Squeeze (Médias Próximas)
avgDist = math.abs(smaCurta - smaLonga) / atr
isSqueezed = avgDist < (thrSqueeze / 2)

// 3. Código de Barras (Trocas de Cor)
colorChangeCount = 0
for i = 0 to lookback - 1
    if (close[i] > open[i] and close[i+1] < open[i+1]) or (close[i] < open[i] and close[i+1] > open[i+1])
        colorChangeCount := colorChangeCount + 1
isBarcode = colorChangeCount >= thrBarcode

// --- LÓGICA DE PERSISTÊNCIA (HISTERESE) ---
isConsolidInstant = isFlatSMA or isSqueezed or isBarcode

var int barsSinceConsolid = 999
if isConsolidInstant
    barsSinceConsolid := 0
else
    barsSinceConsolid += 1

// O mercado é considerado lateral se foi detectado agora ou nas últimas 'holdConsolid' barras.
isConsolid = barsSinceConsolid <= holdConsolid

// Visualização Sincronizada (offset=1)
bgcolor(isConsolid ? color.new(color.yellow, 80) : na, offset=1, title="Área de Consolidação")

// ==========================================
// --- ESTRATÉGIA ---
// ==========================================
// Controle de carência entre operações para evitar re-entradas imediatas em ruído.
// NZ garante que a primeira operação da sessão não seja bloqueada.
barsSinceExit = ta.barssince(strategy.position_size[1] != 0 and strategy.position_size == 0)
canReenter = nz(barsSinceExit, 999) >= minBarsBetweenTrades

// --- SAÍDAS ---
if strategy.position_size > 0 and close < strategy.position_avg_price
    strategy.close("Long", comment="Breakeven/Loss")
if strategy.position_size < 0 and close > strategy.position_avg_price
    strategy.close("Short", comment="Breakeven/Loss")

if strategy.position_size > 0 and close < smaCurta
    strategy.close("Long", comment="Sem Força")
if strategy.position_size < 0 and close > smaCurta
    strategy.close("Short", comment="Sem Força")

// --- ENTRADAS E RETOMADAS ---
longCond  = smaCurta > smaLonga and close > smaCurta and not isConsolid and canReenter
shortCond = smaCurta < smaLonga and close < smaCurta and not isConsolid and canReenter

if longCond
    strategy.entry("Long", strategy.long)

if shortCond
    strategy.entry("Short", strategy.short)
