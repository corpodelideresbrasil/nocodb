//@version=6
strategy("Raul Lateralidade v3.2", overlay=true, margin_long=100, margin_short=100)

// ==========================================
// --- INPUTS ---
// ==========================================
lenCurta  = input.int(9, "SMA Curta", tooltip="Período da Média Móvel Simples de curto prazo.")
lenLonga  = input.int(21, "SMA Longa", tooltip="Período da Média Móvel Simples de longo prazo.")
lookback  = input.int(7, "Lookback Lateralidade", minval=1, tooltip="Período de observação para detectar a lateralidade.")

// --- CONTROLES DE SENSIBILIDADE (VALORES SUGERIDOS) ---
thrFlat    = input.float(1.1, "Sensibilidade Inclinação", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta média horizontal.")
thrSqueeze = input.float(0.5, "Sensibilidade Squeeze", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta médias próximas.")
thrBarcode = input.int(6, "Sensibilidade Código de Barras", minval=2, maxval=14, tooltip="Detecta indecisão de cores.")

// ==========================================
// --- CÁLCULOS ---
// ==========================================
smaCurta = ta.sma(close, lenCurta)
smaLonga = ta.sma(close, lenLonga)
atr      = ta.atr(lookback)

// Plot das Médias
plot(smaCurta, color=color.orange, linewidth=2, title="SMA Curta")
plot(smaLonga, color=color.blue, linewidth=2, title="SMA Longa")

// --- DETECÇÃO DE LATERALIDADE (MULTI-COMPONENTES) ---
// 1. Horizontalidade da SMA Curta (Slope)
smaSlope = math.abs(smaCurta - smaCurta[5]) / atr
isFlatSMA = smaSlope < (thrFlat / 4)

// 2. Squeeze (Médias Próximas)
avgDist = math.abs(smaCurta - smaLonga) / atr
isSqueezed = avgDist < (thrSqueeze / 2)

// 3. Código de Barras (Trocas de Cor)
colorChangeCount = 0
for i = 0 to lookback - 1
    if (close[i] > open[i] and close[i+1] < open[i+1]) or (close[i] < open[i] and close[i+1] > open[i+1])
        colorChangeCount := colorChangeCount + 1
isBarcode = colorChangeCount >= thrBarcode

// Lógica Final: Qualquer um dos 3 ativa o bloqueio
isConsolid = isFlatSMA or isSqueezed or isBarcode

// VISUALIZAÇÃO SINCRONIZADA:
// No Pine Script (Strategy), uma condição calculada no fechamento da barra T
// afeta a execução na abertura da barra T+1. Usamos offset=1 para que o fundo amarelo
// apareça na barra onde a entrada será efetivamente bloqueada ou a saída ocorrerá.
bgcolor(isConsolid ? color.new(color.yellow, 80) : na, offset=1, title="Área de Consolidação (Próxima Barra)")

// ==========================================
// --- ESTRATÉGIA ---
// ==========================================
entryPrice = strategy.position_avg_price

// --- SAÍDAS ---
// Saída Breakeven/Loss
if strategy.position_size > 0 and close < entryPrice
    strategy.close("Long", comment="Breakeven/Loss")
if strategy.position_size < 0 and close > entryPrice
    strategy.close("Short", comment="Breakeven/Loss")

// Saída por Perda de Força (Crossover com SMA Curta)
if strategy.position_size > 0 and close < smaCurta
    strategy.close("Long", comment="Sem Força")
if strategy.position_size < 0 and close > smaCurta
    strategy.close("Short", comment="Sem Força")

// --- ENTRADAS E RETOMADAS ---
// Condição de Compra (Long):
longCond  = smaCurta > smaLonga and close > smaCurta and not isConsolid

// Condição de Venda (Short):
shortCond = smaCurta < smaLonga and close < smaCurta and not isConsolid

if longCond
    strategy.entry("Long", strategy.long)

if shortCond
    strategy.entry("Short", strategy.short)
