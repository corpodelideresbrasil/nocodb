//@version=6
indicator("Crypto MA Crossover Indicator", overlay=true)

// --- Inputs ---
short_len = input.int(9, "Short SMA Length", minval=1, tooltip="Period for the short-term Simple Moving Average")
long_len = input.int(21, "Long SMA Length", minval=1, tooltip="Period for the long-term Simple Moving Average")
slope_period = input.int(5, "Slope Lookback Period", minval=1, tooltip="Number of bars to calculate the average slope (horizontal detection)")
slope_threshold = input.float(0.1, "Slope Threshold (%)", minval=0.0, step=0.01, tooltip="Threshold for horizontal movement detection. Below this %, the MA is considered horizontal.")

// --- Calculations ---
short_ma = ta.sma(close, short_len)
long_ma = ta.sma(close, long_len)

// --- States and Alerts ---
// Alerta de alta: Curta acima da longa
is_bullish_alert = short_ma > long_ma
// Alerta de baixa: Curta abaixo da longa
is_bearish_alert = short_ma < long_ma

// Crossover triggers
bull_cross = ta.crossover(short_ma, long_ma)
bear_cross = ta.crossunder(short_ma, long_ma)

// --- Inclinação (Slope) and Reversals ---
short_slope_pos = short_ma > short_ma[1]
short_slope_neg = short_ma < short_ma[1]

// Reversão da alta: inclinação da curta muda de positiva para negativa
high_reversal = short_slope_neg and short_slope_pos[1]
// Reversão da baixa: inclinação da curta muda de negativa para positiva
low_reversal = short_slope_pos and short_slope_neg[1]

// --- Trend and Trading Signals ---
// Tendencia de alta: alerta de alta e fechamento acima da longa
bullish_trend = is_bullish_alert and close > long_ma
// Tendencia de baixa: alerta de baixa e fechamento abaixo da longa
bearish_trend = is_bearish_alert and close < long_ma

// Fecha operação de compra: alerta de alta e fechamento abaixo da longa
close_buy = is_bullish_alert and close < long_ma
// Fecha operação de venda: alerta de baixa e fechamento acima da longa
close_sell = is_bearish_alert and close > long_ma

// Detectar Consolidação (Mercado Lateral)
// Calcula a mudança percentual das médias em relação ao fechamento
short_slope = (short_ma - short_ma[slope_period]) / close[slope_period] * 100
long_slope = (long_ma - long_ma[slope_period]) / close[slope_period] * 100

// Mercado é considerado lateral se ambas as médias estiverem "horizontais" (dentro do threshold)
is_lateral = math.abs(short_slope) < slope_threshold and math.abs(long_slope) < slope_threshold

// Lateral / Não opera: Mesma condição de fechar operação + filtro de consolidação
is_neutral = (is_bullish_alert and close < long_ma) or (is_bearish_alert and close > long_ma) or is_lateral

// Compra: Alerta de alta e fechamento acima da longa, e NÃO estar lateral
buy_signal = bullish_trend and not bullish_trend[1] and not is_lateral
// Venda: Alerta de baixa e fechamento abaixo da longa, e NÃO estar lateral
sell_signal = bearish_trend and not bearish_trend[1] and not is_lateral

// --- Visual Plotting ---
plot(short_ma, color=color.blue, linewidth=2, title="Short SMA")
plot(long_ma, color=color.orange, linewidth=2, title="Long SMA")

// Plot background colors for trends and consolidation
bgcolor(is_lateral ? color.new(color.yellow, 80) : bullish_trend ? color.new(color.green, 90) : bearish_trend ? color.new(color.red, 90) : is_neutral ? color.new(color.gray, 90) : na)

// Plot shapes for signals
plotshape(buy_signal, title="Compra", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="COMPRA")
plotshape(sell_signal, title="Venda", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="VENDA")

// Plot shapes for closures
plotshape(close_buy and not close_buy[1], title="Fechar Compra", style=shape.labeldown, location=location.abovebar, color=color.orange, size=size.tiny, text="FECHAR C", textcolor=color.white)
plotshape(close_sell and not close_sell[1], title="Fechar Venda", style=shape.labelup, location=location.belowbar, color=color.orange, size=size.tiny, text="FECHAR V", textcolor=color.white)

// Plot reversal markers
plotchar(high_reversal, title="Reversão Alta", char='▼', location=location.abovebar, color=color.yellow, size=size.tiny)
plotchar(low_reversal, title="Reversão Baixa", char='▲', location=location.belowbar, color=color.yellow, size=size.tiny)

// --- Alerts ---
alertcondition(bull_cross, title="Alerta de Alta (Cruzamento)", message="Curta cruzou a longa para cima!")
alertcondition(bear_cross, title="Alerta de Baixa (Cruzamento)", message="Curta cruzou a longa para baixo!")
alertcondition(buy_signal, title="Sinal de Compra", message="Tendência de Alta Confirmada: Compra!")
alertcondition(sell_signal, title="Sinal de Venda", message="Tendência de Baixa Confirmada: Venda!")
alertcondition(high_reversal, title="Reversão de Inclinação (Alta)", message="Inclinação da MA curta virou para baixo")
alertcondition(low_reversal, title="Reversão de Inclinação (Baixa)", message="Inclinação da MA curta virou para cima")
