//@version=6
strategy("Raul Lateralidade v3", overlay=true, margin_long=100, margin_short=100)

// ==========================================
// --- INPUTS ---
// ==========================================
lenCurta  = input.int(9, "SMA Curta", tooltip="Período da Média Móvel Simples de curto prazo.")
lenLonga  = input.int(21, "SMA Longa", tooltip="Período da Média Móvel Simples de longo prazo.")
lookback  = input.int(14, "Lookback Lateralidade", minval=1, tooltip="Período de observação para os filtros de lateralidade.")

// --- CONTROLES DE SENSIBILIDADE ---
// Estes inputs permitem ajustar o que o algoritmo considera "lateral".
thrFlat    = input.float(1.1, "Sensibilidade Inclinação (Horizontal)", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta quando a média curta está horizontal. Aumente para detectar mais áreas.")
thrSqueeze = input.float(1.8, "Sensibilidade Squeeze (Médias Próximas)", minval=0.1, maxval=10.0, step=0.1, tooltip="Detecta quando as duas médias estão 'coladas'. Aumente para ser mais sensível.")
thrBarcode = input.int(6, "Sensibilidade 'Código de Barras'", minval=2, maxval=14, tooltip="Número de trocas de cor (verde/vermelho) no período para sinalizar indecisão.")

// ==========================================
// --- CÁLCULOS ---
// ==========================================
smaCurta = ta.sma(close, lenCurta)
smaLonga = ta.sma(close, lenLonga)
atr      = ta.atr(lookback)

// Plot das Médias
plot(smaCurta, color=color.orange, linewidth=2, title="SMA Curta")
plot(smaLonga, color=color.blue, linewidth=2, title="SMA Longa")

// --- DETECÇÃO DE LATERALIDADE (MULTI-COMPONENTES) ---

// Componente 1: Horizontalidade da SMA Curta
// Medimos a variação da média em 5 barras e normalizamos pelo ATR para funcionar em qualquer ativo.
smaSlope = math.abs(smaCurta - smaCurta[5]) / atr
isFlatSMA = smaSlope < (thrFlat / 4)

// Componente 2: Squeeze (Médias Próximas)
// Distância entre a SMA Curta e SMA Longa proporcional à volatilidade atual (ATR).
avgDist = math.abs(smaCurta - smaLonga) / atr
isSqueezed = avgDist < (thrSqueeze / 2)

// Componente 3: Código de Barras (Trocas de Cor)
// Conta quantas vezes a vela mudou de direção (alta/baixa) no período de lookback.
colorChangeCount = 0
for i = 0 to lookback - 1
    if (close[i] > open[i] and close[i+1] < open[i+1]) or (close[i] < open[i] and close[i+1] > open[i+1])
        colorChangeCount := colorChangeCount + 1
isBarcode = colorChangeCount >= thrBarcode

// --- LÓGICA FINAL DE LATERALIDADE ---
// O mercado é considerado lateral se QUALQUER um dos critérios acima for verdadeiro.
isConsolid = isFlatSMA or isSqueezed or isBarcode

// Destaque visual: Fundo amarelo sinaliza a consolidação detectada.
bgcolor(isConsolid ? color.new(color.yellow, 80) : na, title="Área de Consolidação")

// ==========================================
// --- ESTRATÉGIA ---
// ==========================================
crossUp    = ta.crossover(smaCurta, smaLonga)
crossDown  = ta.crossunder(smaCurta, smaLonga)
entryPrice = strategy.position_avg_price

// --- REGRAS DE SAÍDA ---
// Fechamento agressivo se o preço recuar abaixo da entrada (Proteção de Capital)
if strategy.position_size > 0 and close < entryPrice
    strategy.close("Long", comment="Breakeven/Loss")

if strategy.position_size < 0 and close > entryPrice
    strategy.close("Short", comment="Breakeven/Loss")

// Saída por perda de força (preço cruza a média curta contra a posição)
if strategy.position_size > 0 and close < smaCurta
    strategy.close("Long", comment="Sem Força")

if strategy.position_size < 0 and close > smaCurta
    strategy.close("Short", comment="Sem Força")

// --- REGRAS DE ENTRADA ---
// 'wasFlat' evita entradas consecutivas sem um intervalo de 'estar fora do mercado'.
wasFlat = strategy.position_size[1] == 0 and strategy.position_size == 0

// Setup básico: Preço acima/abaixo das médias e médias alinhadas.
longSetup  = smaCurta > smaLonga and close > smaCurta
shortSetup = smaCurta < smaLonga and close < smaCurta

// Entrada Long: Cruzamento ou Setup, mas BLOQUEADO se 'isConsolid' for verdadeiro.
if (crossUp or (wasFlat and longSetup)) and not isConsolid
    strategy.entry("Long", strategy.long)

// Entrada Short: Cruzamento ou Setup, mas BLOQUEADO se 'isConsolid' for verdadeiro.
if (crossDown or (wasFlat and shortSetup)) and not isConsolid
    strategy.entry("Short", strategy.short)
