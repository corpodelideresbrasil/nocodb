//@version=6
indicator("Market Phisics Regime Model - V15.0", shorttitle="MPRM V15.0", overlay=true, max_bars_back=5000)

// --- 0. CONFIGURAÇÕES ---
int markov_len = input.int(20, "Lookback de Referência", minval=5, tooltip="Comprimento para ATR e Médias de Volume. As transições de estado agora são instantâneas para remover lag.")
float sl_mult  = input.float(1.5, "Multiplicador do Stop (ATR)", minval=0.5, step=0.1, tooltip="Ajusta a distância do trailing stop.")
float h_threshold = input.float(0.05, "Histerese (Termostato)", minval=0.0, step=0.01, tooltip="Margem mínima de probabilidade para trocar de estado.")
float entry_price = input.float(0.0, "Preço de Entrada (opcional)", minval=0.0, tooltip="Se preenchido, o HUD mostrará o PnL (%) da operação.")

// --- 1. MÓDULO DE FÍSICA (FOCO NO AGORA - REFINADO F=M.A) ---
// Massa (m) = Volume Normalizado
float vol_ema = ta.ema(volume, markov_len)
float mass = nz(volume / vol_ema, 1.0)

// Trabalho/Aceleração (a)
float body_work = math.abs(close - open)

// Força Aplicada (F = m * a)
float f_bull_i  = close > open ? mass * body_work : 0.0
float f_bear_i  = close < open ? mass * body_work : 0.0

// Compressão: Energia Potencial com Massa
float atr_ref  = ta.atr(markov_len)
float f_comp_i = math.max(0.0, atr_ref - (high - low)) * mass

// Exaustão: Perda de Energia por Entropia (Pavios)
float wicks   = (high - math.max(open, close)) + (math.min(open, close) - low)
float f_exh_i = wicks > (body_work * 2.0) ? wicks : 0.0

// Normalização das Probabilidades Instantâneas (O "Agora")
float total_i = f_bull_i + f_bear_i + f_comp_i + f_exh_i

// Piso de Ruído (Atrito Estático)
float noise_floor = ta.ema(total_i, markov_len) * 0.5
float p_bull_i = total_i > 0 ? f_bull_i / total_i : 0.25
float p_bear_i = total_i > 0 ? f_bear_i / total_i : 0.25
float p_comp_i = total_i > 0 ? f_comp_i / total_i : 0.25
float p_exh_i  = total_i > 0 ? f_exh_i  / total_i : 0.25

// --- 2. CADEIA DE MARKOV (INSTANTÂNEA V15.0) ---
// Removemos a EMA para eliminar o lag temporal e focar na física do AGORA
float p_bull = p_bull_i
float p_bear = p_bear_i
float p_comp = p_comp_i
float p_exh  = p_exh_i

// --- 3. REGIME COM HISTERESE (V15.0) ---
var int regime = 3
float p_curr = regime == 0 ? p_bull : regime == 1 ? p_bear : regime == 2 ? p_comp : p_exh
float max_p_val = math.max(p_bull, p_bear, p_comp, p_exh)
int max_p_idx = p_bull == max_p_val ? 0 : p_bear == max_p_val ? 1 : p_comp == max_p_val ? 2 : 3

if (max_p_val > p_curr + h_threshold) or (p_curr < 0.25)
    regime := max_p_idx
color regime_col = regime == 0 ? color.green : regime == 1 ? color.red : regime == 2 ? color.blue : color.orange

// Estado Dinâmico Markoviano
float trend_energy = p_bull + p_bear
float equilibrium_energy = p_comp + p_exh
string dynamic_state = trend_energy > equilibrium_energy ? "EXPANSION" : p_comp > p_exh ? "CONTRACTION" : "EXHAUSTION"
color state_col = dynamic_state == "EXPANSION" ? color.green : dynamic_state == "CONTRACTION" ? color.blue : color.orange

barcolor(color.new(regime_col, 50))

var int pos_state = 0 // 0: Nenhum, 1: Comprado, -1: Vendido
var float trail_sl = na
float atr_sl = ta.atr(14)

// Sinais de Transição V15.0 (Matriz de Transição)
int prev = nz(regime[1], 3)
var int regime_age = 0
if regime != prev
    regime_age := 0
else
    regime_age := regime_age + 1

bool over_noise = (regime == 0 ? f_bull_i : regime == 1 ? f_bear_i : 0.0) > noise_floor

// Regras de Entrada (V15.0)
bool valid_entry = (regime == 0 or regime == 1) and (prev != 3)
bool enter_long  = (regime == 0) and valid_entry and over_noise and regime_age <= 10 and pos_state <= 0
bool enter_short = (regime == 1) and valid_entry and over_noise and regime_age <= 10 and pos_state >= 0

// Regras de Saída Total
bool exit_trade = (regime == 3) or (pos_state == 1 and regime == 1) or (pos_state == -1 and regime == 0)

// Lógica de Execução e Trailing Stop
float atr_val = nz(atr_sl, ta.atr(14))

if enter_long
    pos_state := 1
    trail_sl := low - (atr_val * sl_mult)
else if enter_short
    pos_state := -1
    trail_sl := high + (atr_val * sl_mult)
else if exit_trade
    pos_state := 0
    trail_sl := na

// Ajuste Dinâmico (Ratcheting) e Flat Count
var int flat_count = 0
if pos_state != 0
    float prev_trail_val = trail_sl
    if pos_state == 1
        float current_sl = low - (atr_val * sl_mult)
        trail_sl := math.max(nz(trail_sl, 0), current_sl)
        if close < trail_sl
            pos_state := 0
            trail_sl := na
    else if pos_state == -1
        float current_sl = high + (atr_val * sl_mult)
        trail_sl := math.min(nz(trail_sl, 1e10), current_sl)
        if close > trail_sl
            pos_state := 0
            trail_sl := na

    if trail_sl == prev_trail_val
        flat_count := flat_count + 1
    else
        flat_count := 0
else
    flat_count := 0

// Lógica de Redução V15.0
bool reduce_50 = pos_state != 0 and (regime == 2 or flat_count >= 3)
bool reduce_30 = pos_state != 0 and math.abs(close - trail_sl) > (atr_val * (sl_mult + 1.0))

// Plotagem da Linha de Inércia
plot(pos_state == 1  ? trail_sl : na, "Long Trail",  color=color.green, linewidth=2, style=plot.style_linebr)
plot(pos_state == -1 ? trail_sl : na, "Short Trail", color=color.red,   linewidth=2, style=plot.style_linebr)

// Sinais Visuais (Minimalistas)
plotshape(enter_long, "Ignition Long", shape.triangleup, location.belowbar, color.green, size=size.small, text="⚡", textcolor=color.green)
plotshape(enter_short, "Ignition Short", shape.triangledown, location.abovebar, color.red, size=size.small, text="🔥", textcolor=color.red)
plotshape(exit_trade and not (enter_long or enter_short), "Break", shape.xcross, location.abovebar, color.new(color.gray, 50), size=size.tiny)

// Visualização de Reduções
plotshape(reduce_50 and not reduce_50[1], "Reduzir 50%", shape.labeldown, location.abovebar, color.orange, size=size.tiny, text="50%", textcolor=color.white)
plotshape(reduce_30 and not reduce_30[1], "Reduzir 30%", shape.labeldown, location.abovebar, color.blue, size=size.tiny, text="30%", textcolor=color.white)

// Cálculos de Métricas V15.0
float f_res_i = regime == 0 ? f_bull_i : regime == 1 ? f_bear_i : 0.0
float force_ratio = noise_floor > 0 ? f_res_i / noise_floor : 1.0
float markov_strength = regime == 0 ? p_bull : regime == 1 ? p_bear : 0.25
float conviction = markov_strength * math.min(2.0, force_ratio)

float current_pnl = entry_price > 0 ? ((close / entry_price) - 1) * pos_state * 100 : na

// --- 4. HUD TABLE ---
var table hud = table.new(position.top_right, 3, 10, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    table.merge_cells(hud, 0, 0, 2, 0)
    table.cell(hud, 0, 0, syminfo.ticker + " V15.0 | STATE: " + dynamic_state, text_color=state_col, text_size=size.small)

    table.cell(hud, 0, 1, "FORÇA", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 1, "AGORA", text_color=color.gray, text_size=size.small)
    table.cell(hud, 2, 1, "TRANS.", text_color=color.gray, text_size=size.small)

    table.cell(hud, 0, 2, "BULL", text_color=color.green, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(p_bull_i * 100, "#.0") + "%", text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 2, regime == 0 ? "ATV" : "---", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "BEAR", text_color=color.red, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(p_bear_i * 100, "#.0") + "%", text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 3, regime == 1 ? "ATV" : "---", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "COMP", text_color=color.blue, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(p_comp_i * 100, "#.0") + "%", text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 4, regime == 2 ? "ATV" : "---", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "EXH", text_color=color.orange, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(p_exh_i * 100, "#.0") + "%", text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 5, regime == 3 ? "ATV" : "---", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 6, "MASSA", text_color=color.gray, text_size=size.small)
    table.merge_cells(hud, 1, 6, 2, 6)
    table.cell(hud, 1, 6, str.tostring(mass, "#.00") + " (Vol/EMA)", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 7, "CONV.", text_color=color.gray, text_size=size.small)
    table.merge_cells(hud, 1, 7, 2, 7)
    table.cell(hud, 1, 7, str.tostring(conviction * 100, "#.1") + "%", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 8, "PNL %", text_color=color.gray, text_size=size.small)
    table.merge_cells(hud, 1, 8, 2, 8)
    table.cell(hud, 1, 8, entry_price > 0 ? str.tostring(current_pnl, "+#.##") + "%" : "---", text_color=current_pnl >= 0 ? color.green : color.red, text_size=size.small)

    table.merge_cells(hud, 0, 9, 2, 9)
    table.cell(hud, 0, 9, "PURE PHYSICS - NO LAG (V15.0)", text_color=color.gray, text_size=size.tiny)

// Alertas
alertcondition(enter_long, "MPE: Ignition LONG", "Bull mode ON")
alertcondition(enter_short, "MPE: Ignition SHORT", "Bear mode ON")
alertcondition(exit_trade, "MPE: Break", "Exit signal")

// Alertas de Redução
alertcondition(reduce_50 and not reduce_50[1], "MPE: Reduzir 50%", "Atrito Detectado (COMP/FLAT)")
alertcondition(reduce_30 and not reduce_30[1], "MPE: Reduzir 30%", "Preço Esticado")
